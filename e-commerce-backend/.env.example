# Backend environment variables for cloud deployment (Render + Neon)

# Render will provide PORT automatically in production.
PORT=8080

# Use Neon pooled connection host and SSL.
# Format: jdbc:postgresql://<NEON_HOST>/<DB_NAME>?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=replace_with_real_password

# Optional: override SSL mode. Neon should use require.
DB_SSL_MODE=require

# Optional: set only if your runtime needs a custom CA cert path.
# DB_SSL_ROOT_CERT=
